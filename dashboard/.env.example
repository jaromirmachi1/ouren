# Next.js env — copy to .env.local
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01

# Sanity write token (Editor role) — required to add clients from the portal
SANITY_API_TOKEN=your-sanity-api-token

# Portal login (Auth.js)
# Generate secret: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=replace-with-random-secret
AUTH_URL=http://localhost:5173/admin
AUTH_TRUST_HOST=true
# Comma-separated email:password or email:password:role — roles: viewer | re_agent | ceo
AUTH_USERS=you@ouren.cz:change-me:ceo,colleague@ouren.cz:change-me:re_agent
