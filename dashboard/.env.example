# Next.js env — copy to .env.local
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01

# Portal login (Auth.js)
# Generate secret: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=replace-with-random-secret
AUTH_URL=http://localhost:3000/admin
AUTH_TRUST_HOST=true
# Comma-separated email:password pairs — add a colleague on a new pair
AUTH_USERS=you@ouren.cz:change-me,colleague@ouren.cz:change-me
